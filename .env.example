# =============================================================
# SovereignSelf — Environment Variables
# =============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -------------------------------------------------------------
# Twitter / X  —  @elizaos/plugin-twitter uses TWO auth methods.
# You need BOTH sets for full functionality.
#
# METHOD 1: OAuth 1.0a — needed for posting tweets (write access)
#   Get from: developer.twitter.com → Your App → Keys and Tokens
# -------------------------------------------------------------
TWITTER_API_KEY=
TWITTER_API_SECRET_KEY=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# METHOD 2: Account credentials — used by the scraper for reading
#   mentions, timeline, and search (bypasses expensive API v2 plans)
#   Use a dedicated bot account, not your personal account.
TWITTER_USERNAME=
TWITTER_PASSWORD=
TWITTER_EMAIL=

# Bearer Token — for Twitter API v2 search (Optional but recommended)
#   Get from: developer.twitter.com → Your App → Keys and Tokens
TWITTER_BEARER_TOKEN=

# -------------------------------------------------------------
# Telegram Bot (crisis alerts)
# -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------------------------------------------------
# Nosana GPU Node
# -------------------------------------------------------------
NOSANA_MODEL_ENDPOINT=https://dashboard.nosana.com/jobs/{JOB_ID}/proxy/v1
NOSANA_JOB_ID=
NOSANA_API_KEY=

# -------------------------------------------------------------
# Database (PostgreSQL 16)
# -------------------------------------------------------------
DATABASE_URL=postgresql://sovereign:sovereign@localhost:5432/sovereign

# -------------------------------------------------------------
# API Server
# -------------------------------------------------------------
API_PORT=3001
API_WS_PORT=3002

# -------------------------------------------------------------
# Dashboard (Vite)
# -------------------------------------------------------------
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3002

# -------------------------------------------------------------
# General
# -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info
